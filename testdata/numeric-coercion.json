{
  "comment": "Shared by nodejs/tests/testParsersOffline.js and python/tests/test_parsers_offline.py. Every case must coerce identically in both ports, so add cases here instead of to one language. expected null means the value is unusable and must not become a number: 0 in particular would place the airport in the Gulf of Guinea.",
  "cases": [
    {
      "label": "empty string",
      "input": "",
      "expected": null
    },
    {
      "label": "single space",
      "input": " ",
      "expected": null
    },
    {
      "label": "only spaces",
      "input": "   ",
      "expected": null
    },
    {
      "label": "json null",
      "input": null,
      "expected": null
    },
    {
      "label": "boolean true",
      "input": true,
      "expected": null
    },
    {
      "label": "boolean false",
      "input": false,
      "expected": null
    },
    {
      "label": "empty array",
      "input": [],
      "expected": null
    },
    {
      "label": "array holding a number",
      "input": [
        43
      ],
      "expected": null
    },
    {
      "label": "empty object",
      "input": {},
      "expected": null
    },
    {
      "label": "letters",
      "input": "abc",
      "expected": null
    },
    {
      "label": "coordinate with a hemisphere suffix",
      "input": "43.30 N",
      "expected": null
    },
    {
      "label": "hexadecimal",
      "input": "0x10",
      "expected": null
    },
    {
      "label": "digits grouped with underscores",
      "input": "1_000",
      "expected": null
    },
    {
      "label": "the word inf",
      "input": "inf",
      "expected": null
    },
    {
      "label": "the word NaN",
      "input": "NaN",
      "expected": null
    },
    {
      "label": "exponent overflowing a double",
      "input": "1e999",
      "expected": null
    },
    {
      "label": "negative exponent overflowing a double",
      "input": "-1e999",
      "expected": null
    },
    {
      "label": "400 plain digits",
      "input": "",
      "expected": null
    },
    {
      "label": "negative decimal",
      "input": "-23.4",
      "expected": -23.4
    },
    {
      "label": "whole number as a string",
      "input": "2436",
      "expected": 2436
    },
    {
      "label": "whole number as a number",
      "input": 2436,
      "expected": 2436
    },
    {
      "label": "explicit plus sign",
      "input": "+5",
      "expected": 5
    },
    {
      "label": "leading decimal point",
      "input": ".5",
      "expected": 0.5
    },
    {
      "label": "trailing decimal point",
      "input": "5.",
      "expected": 5
    },
    {
      "label": "scientific notation",
      "input": "1e3",
      "expected": 1000
    },
    {
      "label": "padded with spaces",
      "input": "  12  ",
      "expected": 12
    },
    {
      "label": "integer past 2**53",
      "input": "9007199254740993",
      "expected": 9007199254740992
    },
    {
      "label": "a genuine zero",
      "input": 0,
      "expected": 0
    }
  ]
}
